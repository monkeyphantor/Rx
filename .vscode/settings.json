{
  // On Linux, if CMake is in your system's PATH, you often don't need to set this.
  // If you have a specific installation, you can set the path explicitly, for example: "/usr/bin/cmake".
  "cmake.cmakePath": "cmake",

  // Use the "Unix Makefiles" generator for GCC on Linux. "Ninja" is another popular alternative.
  "cmake.generator": "Unix Makefiles",

  "cmake.configureSettings": {
    // Specify the C and C++ compilers.
    "CMAKE_C_COMPILER": "/usr/bin/gcc",
    "CMAKE_CXX_COMPILER": "/usr/bin/g++",

    // The relative path to the vcpkg toolchain file should work on Linux as well.
    "CMAKE_TOOLCHAIN_FILE": "${workspaceFolder}/../vcpkg/scripts/buildsystems/vcpkg.cmake",

    // The vcpkg triplet for 64-bit Linux.
    "VCPKG_TARGET_TRIPLET": "x64-linux"
  },

